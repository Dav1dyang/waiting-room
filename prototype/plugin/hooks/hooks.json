    "StopFailure":      [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/signal.sh"], "async": true } ] } ],
    "SessionEnd":       [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/signal.sh"], "async": true } ] } ],
    "Elicitation":        [ { "hooks": [ { "type": "command", "async": true, "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/signal.sh" } ] } ],
    "PermissionRequest":[ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/signal.sh"], "async": true } ] } ],
    "PreToolUse":       [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/signal.sh"], "async": true } ] } ],
    "PostToolUse":      [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/signal.sh"], "async": true } ] } ]
  }
